{
  "name": "server",
  "version": "1.0.0",
  "description": "Family-week application",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "seed": "node --env-file=.env src/scripts/seed.js",
    "test": "npm run test:dates && npm run test:integration",
    "test:dates": "node --test test/dates.test.js",
    "test:integration": "node --env-file=.env.test --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "private": true,
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mongoose": "^9.12.0"
  },
  "keywords": [],
  "author": "Yury",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
